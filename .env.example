OPENAI_MODEL=gpt-4o
SERPAPI_KEY=
JSEARCH_API_KEY=
YOUTUBE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
ALLOWED_ORIGINS=https://your-production-domain.example
REQUIRE_API_AUTH=true
RATE_LIMIT_STORE=firestore

# Optional production server settings.
PORT=3000
NODE_ENV=production
